PORT=3000
NODE_ENV=development

# MySQL connection used by the application
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edgenroots
DB_USER=edgenroots
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# Only used by `npm run db:setup` / `npm run db:reset` to create the database and
# the application user. Leave the password empty for a socket/local root login.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Formula execution
#   pool        - supervised pool of worker processes running formula-interpreter's
#                 own evaluator (fast; default)
#   interpretor - one `interpretor()` call per evaluation (public one-shot API, slower)
EVALUATION_MODE=pool
EVALUATION_WORKERS=4
EVALUATION_CONCURRENCY=4
EVALUATION_TIMEOUT_MS=2000
EVALUATION_MEMORY_MB=128
EVALUATION_RECYCLE_AFTER=500

LOG_LEVEL=info
MAX_JSON_BODY_BYTES=1mb

# Tests use a separate schema so they never touch development data.
# `npm run db:setup` creates it alongside DB_NAME.
TEST_DB_NAME=edgenroots_test

# Optional benchmark sizes (npm run benchmark)
# BENCH_EVALS=2000
# BENCH_CONCURRENT_EVALS=2000
# BENCH_INTERPRETOR_EVALS=5
# BENCH_RECORDS=500
